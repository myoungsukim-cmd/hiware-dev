# =============================================================================
# slack-hiware-approval — .env
#
# Docker MySQL 사용 시:
#   1) ./scripts/install-docker.sh
#   2) cp docker/mysql/.env.example docker/mysql/.env && vi docker/mysql/.env
#   3) cp .env.example .env && vi .env  (DB_* 값을 docker/mysql/.env 와 동일하게)
#   4) npm run db:mysql:up && npm run db:init
#   ★ 전체 순서: docs/DEPLOY_GUIDE.md 참고
# =============================================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=true
LOG_LEVEL=info

# DB (Querypie 스타일 — docker/mysql/.env 와 CATALOG/USERNAME/PASSWORD/PORT 동일)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CATALOG=slack_hiware_approval
DB_USERNAME=slack_hiware
DB_PASSWORD=change-me
DB_MAX_CONNECTION_SIZE=10

# ── HIWARE External API ───────────────────────────
HIWARE_BASE_URL=https://172.25.2.101:11200/hiware/v1/ext
# 권장: 서비스 계정 ID/PW → 앱이 Login Interface로 authKey 자동 발급·만료 시 재발급
HIWARE_USER_ID=your-hiware-user
HIWARE_USER_PWD=your-hiware-password
# 레거시(선택): 고정 토큰. USER_ID/PWD 가 있으면 로그인 모드가 우선
# HIWARE_API_TOKEN=your-api-token
HIWARE_INSECURE=true
HIWARE_TIMEOUT_MS=120000

# ── Slack App (manifest 설치 후) ──────────────────
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
# 운영은 반드시 false
SLACK_SKIP_SIGNATURE=false

# ── Worker / Job 주기 (ms) ────────────────────────
JOB_POLL_INTERVAL_MS=1000
JOB_BATCH_SIZE=5
JOB_MAX_ATTEMPTS=5
JOB_USER_SYNC_INTERVAL_MS=86400000
JOB_APPROVAL_SYNC_INTERVAL_MS=30000
JOB_REMINDER_INTERVAL_MS=900000
JOB_RECONCILE_INTERVAL_MS=3600000
RUN_INITIAL_SYNC_ON_START=true

# ── 재알림 §19 ────────────────────────────────────
REMINDER_FIRST_DELAY_MIN=60
REMINDER_INTERVAL_MIN=120
REMINDER_MAX_COUNT=3

# ── 결재 ──────────────────────────────────────────
APPROVAL_COMMENT_MIN_LENGTH=5
APPROVAL_DEFAULT_STEP=1
# true(기본)=Modal 비밀번호로 결재자 본인 로그인 후 applyApv (서비스 계정은 동기화 전용)
# false=서비스 계정 토큰으로 대리 결재 (HIWARE가 허용할 때만)
APPROVAL_APPLY_AS_APPROVER=true
# true=applyApv body에 apvUserPwd도 포함 (정책상 결재 비밀번호 필수일 때)
# applyAsApprover=true 이면 Modal 비밀번호는 로그인에 사용 (이 값이 false여도 비밀번호 입력란 표시)
APPROVAL_REQUIRE_APV_USER_PWD=false

# ── (선택) 수동 DM / 검증 ─────────────────────────
# SLACK_TEST_USER_ID=Uxxxx
# TEST_APV_APLT_NO=4
# INTRAY_USER_NOS=21,12,14
# VERIFY_BASE_URL=http://127.0.0.1:3000
#
# 결재선 시나리오 PoC (docs/SCENARIO_POC.md)
# POC_STEP1_USER_NOS=10
# POC_PARALLEL_USER_NOS=21,22,23
# POC_CISO_USER_NOS=30
# POC_SCENARIO=A
# POC_PHASE=after_submit
# POC_APV_APLT_NO=15

# ── 레거시 (선택, DB_* 없을 때만 사용) ─────────────
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=slack_hiware_approval
# MYSQL_USER=slack_hiware
# MYSQL_PASSWORD=change-me
# MYSQL_POOL_SIZE=10
